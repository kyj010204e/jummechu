generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model favorite_restaurants {
  id              BigInt   @id @default(autoincrement())
  user_id         BigInt
  restaurant_name String   @db.VarChar(255)
  category        String?  @db.VarChar(255)
  address         String?  @db.VarChar(500)
  latitude        Float
  longitude       Float
  created_at      DateTime @default(now()) @db.Timestamp(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_favorite_restaurants_user")
}

model saved_locations {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  name       String   @db.VarChar(100)
  latitude   Float
  longitude  Float
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_locations_user")
}

model user_preferences {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  menu_type  String   @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_preferences_user")

  @@unique([user_id, menu_type], map: "uq_user_menu")
}

model users {
  id                   BigInt                 @id @default(autoincrement())
  email                String                 @unique @db.VarChar(255)
  password_hash        String                 @db.VarChar(255)
  name                 String                 @db.VarChar(100)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  profile_image_url    String?                @db.VarChar(500)
  profile_avatar_key   String                 @default("chef") @db.VarChar(50)
  favorite_restaurants favorite_restaurants[]
  saved_locations      saved_locations[]
  user_preferences     user_preferences[]
}
